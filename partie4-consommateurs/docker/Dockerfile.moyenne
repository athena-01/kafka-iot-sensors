# ║    mvn package -pl partie4-consommateurs -am -DskipTests         ║
# ╚══════════════════════════════════════════════════════════════════╝

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN mkdir -p /app/logs

COPY target/consommateur-moyenne-fat.jar app.jar

ENTRYPOINT ["java", "-jar", "app.jar"]
